--- /dev/null
+++ b/src/calc/ops.py
@@ -0,0 +1,13 @@
+def add(num1, num2):
+    return num1 + num2
+
+def subtract(num1, num2):
+    return num1 - num2
+
+def multiply(num1, num2):
+    return num1 * num2
+
+def divide(num1, num2):
+    if num2 == 0:
+        raise ValueError("Division by zero is not allowed.")
+    return num1 / num2
